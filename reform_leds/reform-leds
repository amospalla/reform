@dataclasses.dataclass
class Hidraw:
    name: str
    udev_pattern: str
    has_oled: bool
    oled_width: int
    oled_heiht: int
    has_keyboard_leds: bool
    keyboard_leds_width: int
    keyboard_leds_height: int
    path: Path | None = None
    available: bool = False

    def print(self) -> None:
        if self.path is None:
            path = ""
        else:
            path = f" path={self.path}"
        if self.has_oled:
            oled_text = f"{self.oled_width}x{self.oled_heiht}"
        else:
            oled_text = "no"
        if self.has_keyboard_leds:
            keyboard_text = f"{self.keyboard_leds_width}x{self.keyboard_leds_height}"
        else:
            keyboard_text = "no"
        print(
            f"{self.name}:",
            f"available={self.available}{path}",
            f"oled={oled_text}",
            f"keyboard={keyboard_text}",
        )


