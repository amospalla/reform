def command_draw(file: Path, color: RGBT, output: Output) -> None:
    if file == READ_FROM_STDIN:
        lines = sys.stdin.readlines()
    else:
        with file.open("r") as f:
            lines = f.readlines()
    string = " ".join(clean_line for line in lines if (clean_line := line.strip()))
    output.write(
        Pixels(
            image_format="rgb",
            rgb=Pixels.pixels_from_string(
                default_color=color,
                string=string,
            ),
        ),
    )


def command_bitmap(
    file: Path,
    image_format: Literal["1bit", "rgb"],
    color: RGBT,
    output: Output,
) -> None:
    if file == READ_FROM_STDIN:
        bitmap = sys.stdin.buffer.read()
    else:
        with file.open("rb") as f:
            bitmap = f.read()
    match image_format:
        case "1bit":
            rgb_list = [
                color if c == "1" else Color.black.value
                for byte in bitmap
                for c in f"{byte:08b}"
            ]
        case "rgb":
            rgb_list = [
                (
                    int.from_bytes(bitmap[i : i + 1]),
                    int.from_bytes(bitmap[i + 1 : i + 2]),
                    int.from_bytes(bitmap[i + 2 : i + 3]),
                )
                for i in range(0, len(bitmap), 3)
            ]
    output.write(Pixels(image_format="rgb", rgb=rgb_list))


def command_text(  # noqa: C901, PLR0912
    file: Path,
    font_size: str,
    color: RGBT,
    scroll: Literal["vertical", "horizontal", "none"],
    scroll_sleep: float,
    scroll_repeat: int,
    scroll_length: int,
    symbols_file: Path | None,
    font_file: Path | None,
    font_spacing: tuple[int, int],
    output: Output,
) -> None:
    if file == READ_FROM_STDIN:
        lines = sys.stdin.readlines()
    else:
        with file.open("r") as f:
            lines = f.readlines()

    if symbols_file:
        with symbols_file.open("r") as f:
            SYMBOLS.append(f.read())

    if font_file:
        with font_file.open("r") as f:
            global FONTS  # noqa: PLW0603
            FONTS = [f.read(), *FONTS]

    text_instance = Text(font_size, font_spacing=font_spacing)

    direction: Literal["forward", "backward"] = "forward"
    overflow = None
    offset = [0, 0]
    if scroll == "horizontal":
        scroll_direction = 0
    else:
        scroll_direction = 1
    text_lines = [line.rstrip() for line in lines]
    while True:
        bool_matrix, current_overflow = text_instance.text_matrix(
            text_lines=text_lines,
            matrix_width=output.width,
            matrix_height=output.height,
            offset=offset,
        )
        output.write(
            Pixels(
                image_format="1bit",
                boolean=bool_matrix,
                default_color=color,
            ),
        )

        if overflow is None:
            overflow = current_overflow

        if overflow[scroll_direction] == 0 or scroll == "none" or scroll_repeat == 0:
            break

        if overflow[scroll_direction]:
            if direction == "forward":
                if current_overflow[scroll_direction] == 0:
                    # No more overflow, change direction from forward to backwards.
                    scroll_repeat -= 1
                    direction = "backward"
                else:
                    offset[scroll_direction] += min(
                        current_overflow[scroll_direction],
                        scroll_length,
                    )
            elif direction == "backward":
                if current_overflow[scroll_direction] == overflow[scroll_direction]:
                    # Arrived to the start, change direction from backwards to forward.
                    scroll_repeat -= 1
                    direction = "forward"
                else:
                    offset[scroll_direction] -= min(
                        offset[scroll_direction],
                        scroll_length,
                    )
        time.sleep(scroll_sleep)


def main() -> None:  # noqa: C901
    args = argparse_get_args()
    Log.set_logging_level(args.log_level)
    logger.info("User supplied arguments: %s.", args)

    if args.command == "hidraw":
        for h in get_hidraws(False):
            h.print()
        return

    try:
        match args.output:
            case "keyboard":
                hidraw = get_hidraws(True, "keyboard")[0]
                output: Output = KeyboardLeds(
                    hidraw.path,  # ty:ignore[invalid-argument-type]
                    hidraw.keyboard_leds_width,
                    hidraw.keyboard_leds_height,
                )
            case "oled":
                hidraw = get_hidraws(True, "oled")[0]
                output = OledDisplay(
                    hidraw.path,  # ty:ignore[invalid-argument-type]
                    hidraw.oled_width,
                    hidraw.oled_heiht,
                )
            case "stdout":
                output = Stdout(Path("/"), 128, 32)
            case _:
                raise ValueError("Invalid output")

        match args.command:
            case "fill":
                output.fill(args.color)
            case "draw":
                command_draw(args.file, args.color, output)
            case "bitmap":
                command_bitmap(args.file, args.format, args.color, output)
            case "text":
                command_text(
                    args.file,
                    args.font_size,
                    args.color,
                    args.scroll,
                    args.scroll_sleep,
                    args.scroll_repeat,
                    args.scroll_length,
                    args.symbols_file,
                    args.font_file,
                    (args.font_spacing_horizontal, args.font_spacing_vertical),
                    output,
                )
    except (
        FontNotFoundError,
        HidrawDeviceNotFoundError,
        InvalidSizeError,
        InvalidTokenError,
    ):
        sys.exit(1)


