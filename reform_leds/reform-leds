def argparse_color_parser(value: str) -> RGBT:
    """Parser for input color."""
    if (color_tuple := Pixels.token2rgb(value)) is None:
        raise argparse.ArgumentTypeError(f"invalid color: {value}")
    return color_tuple


def argparse_font_size(value: str) -> str:
    """Parser for input font size."""
    if not re.match(FONT_SIZE_PATTERN, value):
        raise argparse.ArgumentTypeError(f'invalid font size: "{value}"')
    return value


def argparse_file_path(value: str) -> Path:
    """Parser for Path object that must exist."""
    if (file_path := Path(value)).exists():
        return file_path
    raise argparse.ArgumentTypeError(f'invalid file path: "{value}"')


def argparse_file_path_or_stdin(value: str) -> Path:
    """Parser for Path object that must exist with fallback to stdin.

    If user input equals to "-", return a path for the root folder, which will be later
    iterpreted as the user requested to read from stdin.
    """
    file_path = Path(value)
    if file_path.exists():
        return file_path
    elif value == "-":
        return READ_FROM_STDIN
    raise argparse.ArgumentTypeError(f'invalid file path: "{value}"')


def argparse_add_file_argument(subparser: argparse.ArgumentParser) -> None:
    """Add a 'file' argument to a parser."""
    subparser.add_argument(
        "file",
        type=argparse_file_path_or_stdin,
        help='file path or "-" (stdin)',
    )


def argparse_add_output_argument(subparser: argparse.ArgumentParser) -> None:
    """Add an 'output' argument to a parser."""
    subparser.add_argument(
        "output",
