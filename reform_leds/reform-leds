class Pixels:
    """List of pixels and conversions between them."""

    def __init__(
        self,
        image_format: Literal["1bit", "rgb"],
        boolean: list[bool] | None = None,
        rgb: list[RGBT] | None = None,
        default_color: RGBT = Color.green.value,
    ) -> None:
        self._boolean_pixels = boolean or []
        self._rgb_pixels = rgb or []
        self.default_color = default_color
        self.format = image_format

    @staticmethod
    def token2rgb(token: str) -> RGBT | None:
        """Return a color from a text.

        Format:
            - "#00ff00".
            - "00ff00".
            - "0,255,0".
            - "(0,255,0)".
            - "green".
        """
        # Named color.
        try:
            return (
                Color[token.lower()].value[0],
                Color[token.lower()].value[1],
                Color[token.lower()].value[2],
            )
        except KeyError:
            pass
        # Hexadecimal format.
        if match := re.match(COLOR_PATTERN_HEX, token):
            return (
                int(match.groups()[0][0:2], 16),
                int(match.groups()[0][2:4], 16),
                int(match.groups()[0][4:6], 16),
            )
        # Comma separated integers format.
        if match := re.match(COLOR_PATTERN_DEC, token):
            colors = (
                int(match.groups()[0]),
                int(match.groups()[1]),
                int(match.groups()[2]),
            )
            if all(MIN_RGB_VALUE <= i <= MAX_RGB_VALUE for i in colors):
                return colors
        return None

    @staticmethod
    def tokens2rgb(token: str, color: RGBT) -> list[RGBT] | None:
        """Return a list of color tuples from a text.

        Format: Any combination of characters defined in PIXEL_DOT_TRUE and
        PIXEL_DOT_FALSE.
        """
        if re.match(COLOR_PATTERN_DOT, token):
            return [
                color if character == PIXEL_DOT_TRUE else Color.black.value
                for character in token
            ]
        return None

    @staticmethod
    def pixels_from_string(default_color: RGBT, string: str) -> list[RGBT]:
        """Return a list of pixels from a mixed string format."""
        tokens = string.split()
        pixels: list[RGBT] = []
        for token in tokens:
            if (tuple_rgb := Pixels.token2rgb(token)) is not None:
                pixels.append(tuple_rgb)
            elif (tuples_rgb := Pixels.tokens2rgb(token, default_color)) is not None:
                pixels.extend(tuples_rgb)
            else:
                msg = (
                    f'Invalid token "{token}.", valid format examples: '
                    '"green", "#00ff00","0,255,0", ".", "O"'
                )
                logger.error(msg)
                raise InvalidTokenError(msg)
        return pixels

    @property
    def boolean(self) -> list[bool]:
        match self.format:
            case "1bit":
                # User asks for booleans and data is stored as booleans. Return as-is.
                return self._boolean_pixels
            case "rgb":
                # User asks for booleans and data is stored as rgb. Convert.
                return [
                    any(value for value in color_tuple)
                    for color_tuple in self._rgb_pixels
                ]

    @property
    def rgb(self) -> list[RGBT]:
        match self.format:
            case "1bit":
                # User asks for 1bit and data is stored as rgb. Convert.
                return [
                    self.default_color if value else Color.black.value
                    for value in self._boolean_pixels
                ]
            case "rgb":
                # User asks for rgb and data is stored as rgb. Return as-is.
                return self._rgb_pixels

    def __len__(self) -> int:
        match self.format:
            case "1bit":
                return len(self._boolean_pixels)
            case "rgb":
                return len(self._rgb_pixels)


def get_hidraws(
    first_only_required: bool,
    requires: Literal["oled", "keyboard"] | None = None,
) -> list[Hidraw]:
    if requires == "oled":
        all_hidraw = [h for h in KNOWN_HIDRAWS if h.has_oled]
    elif requires == "keyboard":
        all_hidraw = [h for h in KNOWN_HIDRAWS if h.has_keyboard_leds]
    else:
        all_hidraw = KNOWN_HIDRAWS
    for hidraw in all_hidraw:
        for hidraw_device_path in Path("/sys/class/hidraw/").glob("*"):
            if hidraw.path is not None:
                break
            with (hidraw_device_path / "device/uevent").open("r") as f:
                if re.search(hidraw.udev_pattern, f.read(), re.MULTILINE):
                    hidraw.path = Path("/dev/" + hidraw_device_path.name)
                    hidraw.available = True
                    if first_only_required:
                        return [hidraw]

    if first_only_required:
        logger.error("No known device found.")
        raise HidrawDeviceNotFoundError
    return KNOWN_HIDRAWS


class Output(ABC):
    name: str

    def __init__(self, hidraw: Path, width: int, height: int) -> None:
        self.hidraw = hidraw
        self.width = width
        self.height = height

    def write(self, pixels: Pixels) -> None:
        """Send the input list of pixels to the output."""
        if len(pixels) != self.height * self.width:
            logger.error(
                'The output "%s" has a matrix size of "%s" but received "%s" pixels.',
                self.name,
                self.width * self.height,
                len(pixels),
            )
            raise InvalidSizeError
        self._write(pixels)

    @abstractmethod
    def fill(self, color: RGBT) -> None:
        pass

    @abstractmethod
    def _write(self, pixels: Pixels) -> None:
        pass


class KeyboardLeds(Output):
    name = "keyboard leds"

    def fill(self, color: RGBT) -> None:
        # Note: lrgb hidraw command does also fill the keyboard leds.
        # with self.hidraw.open("wb") as f: f.write(b"xLRGB" + bytes(RGBT))
        self.write(
            Pixels(
                image_format="rgb",
                rgb=[color] * self.width * self.height,
            ),
        )

    def _write(self, pixels: Pixels) -> None:
        """Send XRGB command."""
        rgb_pixels = pixels.rgb
        for row_number in range(self.height):
            with self.hidraw.open("wb") as k:
                message = [row_number]
                row_colors = rgb_pixels[
                    row_number * self.width : (row_number + 1) * self.width
                ]
                if row_number == self.height - 1:
                    # Fix: mouse buttons do not alineate with matrix position.
                    # On last row, right pointer buttons are read from columns number 10
                    # and 11, but visually these rows are 8 and 9.
                    row_colors[9:12] = row_colors[7:9]
                for rgb in row_colors:
                    # Fix: Pocket hidraw reads BGR instead of RGB.
                    message.extend(reversed(rgb))
                k.write(b"xXRGB" + bytes(message))


class OledDisplay(Output):
    name = "OLED display"
    wbio_pages = 4
    wbio_chunk_size = 43

    def fill(self, color: RGBT) -> None:
        value = any(i for i in color)
        self.write(
            Pixels(
                image_format="1bit",
                boolean=[value] * self.width * self.height,
            ),
        )

    def _write(self, pixels: Pixels) -> None:
        """Send a 128x32 boolean matrix to the keyboard OLED using WBIO command.

        bytes:
            - 0-4: "xWBIO"
            - 5:   page (0-3)
            - 6:   column (0-127)
            - 7+:  data
        """
        booleans_wbio_format = self._wbio_oled_format(pixels.boolean)
        with self.hidraw.open("wb") as f:
            for page in range(self.wbio_pages):
                for col in range(0, self.width, self.wbio_chunk_size):
                    # First two page chunks are size 43, third is size 42.
                    chunk_size = min(self.wbio_chunk_size, self.width - col)
                    position = page * self.width + col
                    msg = (
                        b"xWBIO"
                        + bytes([page, col])
                        + booleans_wbio_format[position : position + chunk_size]
                    )
                    _ = f.write(msg)
                    f.flush()  # Force send.

    def _wbio_oled_format(self, booleans: list[bool]) -> bytearray:
        """Return the flat pixel list into the expected hidraw WBIO format.

        Oled matrix is 128x32 pixels.

        It is divided in 4 pages of 8 pixels tall each one:

        xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -> Page 1 (128x8 pixels)
        xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -> Page 2 (128x8 pixels)
        xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -> Page 3 (128x8 pixels)
        xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -> Page 4 (128x8 pixels)

        Each byte encodes a vertical strip of 8 pixels.

        First byte of the message fills first column of the first page (8 pixels).

        Second byte of the message fills second column of the first page (8 pixels), and
        so on.

        For each page (0..3):
        for each column (0..127):
            - Gather the 8 pixels stacked vertically in that column/page into 1 byte.
            - Store the byte at buf[page * 128 + col]
        """
        buffer = bytearray(self.wbio_pages * self.width)
        for page in range(self.wbio_pages):
            for col in range(self.width):
                byte = 0  # Current column byte value
                for bit in range(8):
                    row = page * 8 + bit
                    if booleans[row * self.width + col]:
                        byte |= 1 << bit  # Set the byte's bit position to 1.
                buffer[page * self.width + col] = byte
        return buffer


class Stdout(Output):
    name = "standard output"

    def fill(self, color: RGBT) -> None:
        value = any(i for i in color)
        self.write(
            Pixels(
                image_format="1bit",
                boolean=[value] * self.width * self.height,
            ),
        )

    def _write(self, pixels: Pixels) -> None:
        """Send a 128x32 boolean matrix to stdout."""
        print(
            "\n".join(
                tuple(
                    "".join(
                        tuple(
                            PIXEL_DOT_TRUE if value else PIXEL_DOT_FALSE
                            for value in pixels.boolean[
                                self.width * row : self.width * (row + 1)
                            ]
                        ),
                    )
                    for row in range(self.height)
                ),
            ),
        )


class Text:
    def __init__(
        self,
        font_size: str,
        font_spacing: tuple[int, int] | None = None,
    ) -> None:
        self.font_size = font_size
        # Character data has one extra width and height pixel.
        self.character_width = int(font_size.split("x", maxsplit=1)[0]) + 1
        self.character_height = int(font_size.split("x")[1]) + 1
        self.spacing: tuple[int, int] = font_spacing or (
            FONT_SPACING_UNSET,
            FONT_SPACING_UNSET,
        )
        self.build_font_character_map()
        self.build_symbols_character_map()

    def build_font_character_map(self) -> None:
        """Builds the character map for a font size."""
        found = False
        font_defined_spacing = (0, 0)  # Initialize
        font_lines: list[str] = []  # Initialize
        for font in FONTS:
            # Iterate over fonts list until find one with the specified font size.
            font_lines = [
                line
                for line in font.splitlines()
                if line.strip() and not line.startswith("# ")
            ]
            if match := re.match(FONT_HEADER_PATTERN, font_lines[0]):
                font_size = match.groups()[0]
                font_defined_spacing = (
                    int(match.groups()[1]),
                    int(match.groups()[2]),
                )
                if self.font_size == font_size:
                    found = True
                    break

        if not found:
            logger.error(
                'Font "%s" is not available.',
                self.font_size,
            )
            raise FontNotFoundError(f'Font "{self.font_size}" not found')

        # If the user does not ask for a specific font size, use default from font
        # definition.
        if self.spacing[0] == FONT_SPACING_UNSET:
            self.spacing = (int(font_defined_spacing[0]), self.spacing[1])
        if self.spacing[1] == FONT_SPACING_UNSET:
            self.spacing = (self.spacing[0], int(font_defined_spacing[1]))

        # Read  each character from font definition and build it into self.character_map
        character_map_raw = font_lines[2:]
        character_map: dict[str, tuple[tuple[bool, ...], ...]] = {}
        # A Character code has two characters, first is the code itself, second is the
        # width in characters, implicitly set to 1.
        # extra_index = 0

        # Sum 1 to each access to character width and height, because the font
        # definitions are actually one pixel taller and wider, to allow for drawing
        # characters that can connect each other.
        index = 0

        for code_raw in font_lines[1].split():
            code = code_raw.replace("space", " ")
            if len(code) == 1:
                character_cells = 1
            else:
                character_cells = int(code[1])
            char_data = tuple(
                tuple(
                    char == PIXEL_DOT_TRUE
                    for char in character_map_raw[row][
                        index : index + self.character_width * character_cells
                    ]
                )
                for row in range(self.character_height)
            )

            character_map[code[0]] = char_data
            index += character_cells * self.character_width
        self.character_map = character_map

    def build_symbols_character_map(self) -> None:
        """Adds symbols to the character map."""

        def add_symbol(code: str, lines: list[str]) -> None:
            self.character_map[code] = tuple(
                tuple(dot == PIXEL_DOT_TRUE for dot in line) for line in lines
            )

        code = ""  # Initialize
        font_size = ""  # Initialize
        for symbol in SYMBOLS:
            current_symbol_lines: list[str] = []

            for line in [
                line
                for line in symbol.splitlines()
                if line.strip() and not line.startswith("# ")
            ]:
                if (match := re.match(SYMBOL_HEADER_PATTERN, line)) is not None:
                    # Found new header, add previous symbol, if any.
                    if current_symbol_lines:
                        add_symbol(code, current_symbol_lines[1:])
                        current_symbol_lines = []
                    font_size, code = match.groups()
                if font_size == self.font_size:
                    current_symbol_lines.append(line)

            if current_symbol_lines:
                add_symbol(code, current_symbol_lines[1:])

    def get_code(self, code: str) -> CharacterT:
        """Return a code, else its normalized version, else the fallback character."""
        if code in self.character_map:
            return self.character_map[code]

        # Normalize (remove accents, diacritics, etc)
        code = "".join(
            ch
            for ch in unicodedata.normalize("NFD", code)
            if not unicodedata.combining(ch)
        )
        if code not in self.character_map:
            code = FALLBACK_CHARACTER

        return self.character_map[code]

    def text_matrix(
        self,
        text_lines: list[str],
        matrix_width: int,
        matrix_height: int,
        offset: Sequence[int] = (0, 0),
    ) -> tuple[list[bool], tuple[int, int]]:
        """Return a list of booleans that represent the text on a matrix."""
        matrix_length = matrix_width * matrix_height
        matrix: list[bool | None] = [None] * matrix_length
        # Fonts have one extra pixel padded, so extract one pixel from spacing.
        spacing = (self.spacing[0] - 1, self.spacing[1] - 1)
        overflow_b, overflow_r = 0, 0

        for text_line_number, text_line in enumerate(text_lines):
            for character_index, character_code in enumerate(text_line):
                character_data = self.get_code(character_code)

                # Virtual matrix column start position for this character.
                vmatrix_col_char_starts = character_index * (
                    self.character_width + spacing[0]
                )

                character_height = len(character_data)
                for character_row in range(character_height):
                    # Virtual matrix row position for this character.
                    vmatrix_row_char = (
                        text_line_number * (character_height + spacing[1])
                        + character_row
                    )

                    for char_dot_index, char_dot in enumerate(
                        character_data[character_row],
                    ):
                        # Obtain address this pixel belongs to on the actual display.
                        display_col = (
                            vmatrix_col_char_starts - offset[0] + char_dot_index
                        )
                        display_row = vmatrix_row_char - offset[1]

                        if display_col >= matrix_width:  # Overflow right
                            overflow_r = max(overflow_r, display_col - matrix_width + 1)
                            continue

                        if display_row >= matrix_height:
                            # Overflow bottom,
                            overflow_b = max(
                                overflow_b,
                                display_row - matrix_height + 1,
                            )
                            continue

                        if display_col < 0 or display_row < 0:
                            continue  # overflow left or top

                        character_bool_start_pos = (
                            vmatrix_col_char_starts
                            - offset[0]
                            + (matrix_width * display_row)
                        )
                        pixel_position = character_bool_start_pos + char_dot_index
                        if char_dot or not matrix[pixel_position]:
                            # Do not unset the pixel if it was previously set.
                            matrix[pixel_position] = char_dot
        return matrix, (overflow_r, overflow_b)  # type:ignore[return-value] # ty:ignore[invalid-return-type]


